---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Wavetify — Free Music, Videos, Radio & Podcasts Online',
  description = 'Stream full songs from Audius and Jamendo, YouTube music videos, podcasts and live radio on Wavetify — free, no account, no ads, straight from the source.',
} = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : Astro.url.pathname;
const ogImage = site ? new URL('/og.png', site).toString() : '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#08080a" />
    <meta name="application-name" content="Wavetify" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Wavetify" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wavetify" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wavetify — free music, YouTube music videos, radio and podcasts on a blurred cover-art backdrop" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <div class="install-banner" id="install-banner" role="dialog" aria-label="Install Wavetify" hidden>
      <img class="install-icon" src="/icon-192.png" alt="" width="44" height="44" />
      <div class="install-copy">
        <strong>Install Wavetify</strong>
        <span>Full screen, no browser bars, one tap away.</span>
      </div>
      <button class="install-go" id="install-go" type="button">Install</button>
      <button class="install-close" id="install-close" type="button" aria-label="Not now">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6 18 18M18 6 6 18" />
        </svg>
      </button>
    </div>

    <script>
      import '../scripts/pwa';
    </script>
  </body>
</html>
