---
import Layout from '../layouts/Layout.astro';
import AboutArticle from '../components/AboutArticle.astro';
import TermsArticle from '../components/TermsArticle.astro';
---

<Layout>
  <div class="app">
    <aside class="sidebar">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64">
            <path
              d="M16.5 21 24 43l8-12 8 12 7.5-22"
              fill="none"
              stroke="currentColor"
              stroke-width="7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </span>
        <span class="brand-text">wave<span class="brand-x">tify</span></span>
      </a>

      <nav class="nav" aria-label="Main navigation">
        <button type="button" class="nav-item active" data-view="home" data-nav="home">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 10.5 12 3l9 7.5" /><path d="M5.5 9.5V21h13V9.5" />
          </svg>
          <span class="nav-label">Home</span>
        </button>
        <button type="button" class="nav-item" data-view="videos" data-nav="videos">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="4" /><path d="M8 2v4M16 2v4M2 10h20" />
          </svg>
          <span class="nav-label">Videos</span>
        </button>
        <button type="button" class="nav-item nav-search" data-view="search" data-nav="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
          </svg>
          <span class="nav-label">Search</span>
        </button>
        <button
          type="button"
          class="nav-item"
          data-view="podcasts"
          data-nav="podcasts"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0" /><path d="M12 18v3" />
          </svg>
          <span class="nav-label">Podcasts</span>
        </button>
        <button
          type="button"
          class="nav-item"
          data-view="radio"
          data-nav="radio"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="2" /><path d="M7.8 7.8a6 6 0 0 0 0 8.4" /><path d="M16.2 7.8a6 6 0 0 1 0 8.4" /><path d="M5 5a10 10 0 0 0 0 14" /><path d="M19 5a10 10 0 0 1 0 14" />
          </svg>
          <span class="nav-label">Radio</span>
        </button>
        <button type="button" class="nav-item" data-view="library" data-nav="liked">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path transform="translate(0 -0.6)" d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 3.8C19 15.6 12 20 12 20Z" />
          </svg>
          <span class="nav-label">Liked</span>
        </button>
        <button type="button" class="nav-item nav-playlists" data-view="playlists" data-nav="playlists">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h10" /><path d="M4 12h10" /><path d="M4 17h6" /><circle cx="17.5" cy="16" r="3" /><path d="M20.5 16V8.5l-3 1" />
          </svg>
          <span class="nav-label">Playlists</span>
        </button>

        <!-- On phones the bottom bar keeps one Library tab that holds Liked
             and Playlists; it sits at the far right. -->
        <button type="button" class="nav-item nav-library-tab" id="library-tab" data-view="library">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="7.5" height="16" rx="2" /><rect x="13.5" y="4" width="7.5" height="16" rx="2" />
          </svg>
          <span class="nav-label">Library</span>
        </button>

        <button
          type="button"
          class="nav-item nav-extra"
          data-view="library"
          data-nav="play-again"
          data-section="play-again"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12a8 8 0 1 0 3.2-6.4" /><path d="M4 4v5h5" />
          </svg>
          <span class="nav-label">Play again</span>
        </button>
        <button
          type="button"
          class="nav-item nav-extra"
          data-view="library"
          data-nav="most-played"
          data-section="most-played"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 19V10" /><path d="M10 19V5" /><path d="M16 19v-6" /><path d="M22 19H2" />
          </svg>
          <span class="nav-label">Most played</span>
        </button>
      </nav>

      <div class="sidebar-section">
        <h3>Audio sources</h3>
        <p>
          Full tracks from <strong>Audius</strong> and <strong>Jamendo</strong>, podcasts, live
          radio and <strong>YouTube</strong> music videos. No music files are hosted here.
        </p>
      </div>

      <footer class="sidebar-foot">
        Audio, video &amp; data: Audius, Jamendo, Apple, Radio Browser, YouTube.<br />
        <a href="/terms" data-open-terms>Terms &amp; conditions</a>
      </footer>
    </aside>

    <main class="main">
      <div class="page-bg" id="page-bg" aria-hidden="true"></div>
      <div class="page-bg-top" id="page-bg-top" aria-hidden="true"></div>
      <header class="topbar">
        <a class="mobile-brand" href="/">wave<span class="brand-x">tify</span></a>
        <label class="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
          </svg>
          <input
            id="search-input"
            type="search"
            placeholder="Search songs, artists, genres…"
            autocomplete="off"
            aria-label="Search music"
          />
        </label>
        <button
          class="search-toggle"
          id="search-toggle"
          type="button"
          aria-label="Open search"
          aria-expanded="false"
          aria-controls="search-input"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
          </svg>
          <span class="search-toggle-label">Search</span>
        </button>
        <button class="search-cancel" id="search-cancel" type="button" aria-label="Close search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18" />
          </svg>
        </button>
        <span class="pill">beta</span>
      </header>

      <section class="detail" id="detail" hidden aria-live="polite">
        <button class="detail-close" id="detail-close" type="button" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6 18 18M18 6 6 18" />
          </svg>
        </button>

        <div class="detail-vibe" aria-hidden="true">
          <span class="vibe-art" id="detail-vibe-art"></span>
          <span class="vibe-scrim"></span>
        </div>

        <div class="detail-head">
          <div class="detail-video" id="detail-video">
            <div class="detail-video-frame" id="detail-video-frame"></div>
            <button class="detail-video-fs" id="detail-video-fs" type="button" aria-label="Fullscreen video" title="Fullscreen">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 9V4h5" /><path d="M20 9V4h-5" /><path d="M4 15v5h5" /><path d="M20 15v5h-5" />
              </svg>
            </button>
          </div>
          <div class="detail-art" id="detail-art"><span aria-hidden="true">♪</span></div>
          <div class="detail-copy">
            <p class="detail-eyebrow">
              <span>Now playing</span>
              <span class="vibe-bars" aria-hidden="true">
                <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
              </span>
            </p>
            <h2 id="detail-title">—</h2>
            <p class="detail-artist" id="detail-artist">—</p>
            <div class="detail-foot">
              <span class="detail-meta" id="detail-meta"></span>
              <div class="detail-actions">
                <button class="detail-play" id="detail-play" type="button" aria-label="Play"></button>
                <button class="icon-btn" id="detail-like" type="button" aria-label="Like song">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
                    <path transform="translate(0 -0.6)" d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 3.8C19 15.6 12 20 12 20Z" />
                  </svg>
                </button>
                <button class="icon-btn" id="detail-add" type="button" aria-label="Add to playlist" title="Add to playlist">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 7h9" /><path d="M4 12h9" /><path d="M4 17h5" /><path d="M17 10v7" /><path d="M13.5 13.5h7" />
                  </svg>
                </button>
                <button class="icon-btn" id="detail-share" type="button" aria-label="Share song">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="18" cy="5.5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="18.5" r="2.5" />
                    <path d="M8.2 10.9 15.8 6.6M8.2 13.1l7.6 4.3" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <aside class="detail-video-info" id="detail-video-info" hidden>
            <p class="detail-video-info-head">About this video</p>
            <div class="detail-video-stats">
              <span class="detail-stat"><b id="detail-views">—</b><small>views</small></span>
              <span class="detail-stat"><b id="detail-likes">—</b><small>likes</small></span>
              <span class="detail-stat"><b id="detail-comments">—</b><small>comments</small></span>
            </div>
            <p class="detail-video-desc" id="detail-video-desc"></p>
            <a class="detail-video-link" id="detail-video-link" href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer">
              Watch on YouTube
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6" /><path d="M20 4 10 14" /><path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" /></svg>
            </a>
          </aside>
        </div>

        <div class="detail-list-head">
          <h3>
            <span id="detail-list-prefix">More from</span>{' '}<span id="detail-artist-name">this artist</span>
          </h3>
          <span id="detail-count"></span>
        </div>
        <div class="tracklist" id="detail-list"></div>
      </section>

      <section id="view-home" class="view">
        <div class="hero">
          <p class="eyebrow">Free · legal · no subscription</p>
          <h1>Free Music, Video, Radio<br />and Podcast Stream,<br />only for fun!</h1>
          <p class="sub">
            Full tracks from Audius and Jamendo, podcasts, live radio and music videos from
            YouTube. Everything plays straight from its official source.
          </p>
          <p class="hero-note">
            A free hobby project — no guarantees, just for fun.
            <a href="/terms" data-open-terms>Read the terms</a>.
          </p>
          <div class="chips" id="genre-chips"></div>
        </div>

        <div class="section-head" id="home-play-again-head" hidden>
          <h2>Play again</h2>
          <span>recent</span>
        </div>
        <div class="home-row" id="home-play-again" hidden></div>

        <div class="section-head">
          <h2>Trending now</h2>
          <span>Audius</span>
        </div>
        <div class="home-row" id="trending-grid"></div>

        <div class="section-head" id="home-videos-head" hidden>
          <h2>Videos you watched</h2>
          <span>recent</span>
        </div>
        <div class="home-row" id="home-videos" hidden></div>

        <div class="section-head" id="home-podcasts-head" hidden>
          <h2>Podcast series</h2>
          <span>Apple Podcasts</span>
        </div>
        <div class="home-row" id="home-podcasts" hidden></div>

        <div class="section-head" id="home-radio-head" hidden>
          <h2>Live radio</h2>
          <span>Radio Browser</span>
        </div>
        <div class="home-row" id="home-radio" hidden></div>

        <footer class="home-foot">
          <div class="home-foot-links">
            <button type="button" id="home-clear-history">Clear history</button>
            <a href="/terms" data-open-terms>Terms</a>
            <a href="/about" data-open-about>About</a>
            <a href="https://github.com/dnysaz/wavetify/issues" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
          <p class="home-foot-note">
            Wavetify is free, with no accounts and no ads. Music and videos stay on their
            original sources.
          </p>
        </footer>
      </section>

      <section id="view-search" class="view" hidden>
        <h2 id="search-heading">Search results</h2>
        <p class="search-hint" id="search-hint">
          Type at least 2 characters to search full tracks from Audius and Jamendo, podcast
          episodes, live radio and videos.
        </p>

        <div class="section-head" id="audius-head">
          <h2>Full tracks · Audius</h2>
          <span>full streaming</span>
        </div>
        <div id="audius-results"></div>

        <div class="section-head" id="jamendo-head">
          <h2>Full tracks · Jamendo</h2>
          <span>Jamendo</span>
        </div>
        <div id="jamendo-results"></div>

        <div class="section-head" id="podcast-head">
          <h2>Podcast episodes</h2>
          <span>Apple Podcasts</span>
        </div>
        <div id="podcast-results"></div>

        <div class="section-head" id="radio-head">
          <h2>Live radio</h2>
          <span>Radio Browser</span>
        </div>
        <div id="radio-results"></div>

        <div class="section-head" id="video-head">
          <h2>Videos</h2>
          <span>YouTube</span>
        </div>
        <div id="video-results"></div>
      </section>

      <section id="view-videos" class="view" hidden>
        <h2 id="videos-heading">Videos</h2>
        <p class="search-hint" id="videos-hint">
          YouTube picks based on what you play and search for on this device.
        </p>
        <div class="home-row" id="videos-grid"></div>

        <div class="section-head" id="video-play-again-head" hidden>
          <h2>Play again</h2>
          <span>watched</span>
        </div>
        <div class="home-row" id="video-play-again" hidden></div>

        <div class="section-head" id="video-most-played-head" hidden>
          <h2>Mostly played</h2>
          <span>videos</span>
        </div>
        <div class="home-row" id="video-most-played" hidden></div>
      </section>

      <section id="view-library" class="view" hidden>
        <h2>Your library</h2>

        <div class="section-head">
          <h2>Playlists</h2>
          <button class="section-link" id="library-playlists-all" type="button">View all</button>
        </div>
        <div id="library-playlists-status">
          <div class="status">
            No playlists yet. Use “Add to playlist” while a song, podcast or video is open.
          </div>
        </div>
        <div id="library-playlists"></div>

        <div class="section-head" id="play-again-head">
          <h2>Play again</h2>
          <span>recent</span>
        </div>
        <div id="play-again-grid"></div>

        <div class="section-head" id="most-played-head">
          <h2>Most played</h2>
          <span>on this device</span>
        </div>
        <div id="most-played-grid"></div>

        <div class="section-head" id="history-head">
          <h2>Recently played</h2>
          <span>history</span>
        </div>
        <div class="tracklist" id="history-list"></div>

        <div class="section-head">
          <h2>Liked songs</h2>
          <span>saved on this device</span>
        </div>
        <div id="liked-status">
          <div class="status">No liked songs yet. Tap the heart while a song is playing.</div>
        </div>
        <div id="liked-grid"></div>
      </section>

      <section id="view-playlists" class="view" hidden>
        <h2 id="playlists-heading">Your playlists</h2>

        <div id="playlists-index">
          <div class="playlists-toolbar">
            <p class="search-hint">
              Saved in this browser on this device only — songs, podcasts, radio and videos can
              share one playlist. Nothing is uploaded.
            </p>
            <button class="playlist-new" id="playlist-new" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14" /><path d="M5 12h14" />
              </svg>
              New playlist
            </button>
          </div>
          <div id="playlists-status">
            <div class="status">
              No playlists yet. Open a song, podcast or video and use “Add to playlist”.
            </div>
          </div>
          <div id="playlists-grid"></div>
        </div>

        <div id="playlist-detail" hidden>
          <button class="text-back" id="playlist-back" type="button">← All playlists</button>
          <div class="section-head">
            <h2 id="playlist-name">—</h2>
            <span id="playlist-count"></span>
          </div>
          <div class="playlist-actions">
            <button class="playlist-play" id="playlist-play" type="button">Play all</button>
            <button class="playlist-delete" id="playlist-delete" type="button">Delete playlist</button>
          </div>
          <div class="playlist-find">
            <label class="playlist-search">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" />
              </svg>
              <input
                id="playlist-search"
                type="search"
                placeholder="Search songs or podcasts to add…"
                autocomplete="off"
                aria-label="Search to add to this playlist"
              />
            </label>
            <p class="playlist-search-hint" id="playlist-search-hint">
              Type at least 2 characters, then tap a result to add it to this playlist.
            </p>
            <div class="playlist-results" id="playlist-results"></div>
          </div>

          <div class="status" id="playlist-empty" hidden>
            This playlist is empty. Add tracks with “Add to playlist” or the search above.
          </div>
          <div class="tracklist" id="playlist-tracks"></div>
        </div>
      </section>

      <section id="view-podcasts" class="view" hidden>
        <h2 id="podcasts-heading">Podcasts</h2>
        <button class="text-back" id="podcasts-back" type="button" hidden>← All shows</button>
        <p class="search-hint" id="podcasts-hint"></p>
        <div id="podcasts-grid"></div>
        <button class="load-more" id="podcasts-more" type="button" hidden>Load more shows</button>
      </section>

      <section id="view-radio" class="view" hidden>
        <h2>Live radio</h2>
        <p class="search-hint">
          Live stations from Radio Browser. Use the search field for a station name or genre,
          or tap any station below to start listening.
        </p>
        <div class="section-head">
          <h2>Top stations</h2>
          <span>live</span>
        </div>
        <div id="radio-grid"></div>
        <button class="load-more" id="radio-more" type="button" hidden>Load more stations</button>
      </section>

      <section id="view-terms" class="view" hidden>
        <div class="legal legal-inline">
          <button class="legal-back" id="terms-close" type="button">← Back to music</button>
          <TermsArticle />
        </div>
      </section>

      <section id="view-about" class="view" hidden>
        <div class="legal legal-inline">
          <button class="legal-back" id="about-close" type="button">← Back to music</button>
          <AboutArticle />
        </div>
      </section>
    </main>
  </div>

  <div class="player disabled" id="player">
    <div class="now">
      <button class="now-open" id="now-open" type="button" aria-label="Open the list this song is playing from" disabled>
        <span class="now-art" id="now-art" title="Open full now playing"><span aria-hidden="true">♪</span></span>
        <span class="now-meta">
          <span class="now-title" id="now-title">Nothing playing</span>
          <span class="now-artist" id="now-artist">Pick a song to start</span>
          <span class="now-src" id="now-src"></span>
        </span>
      </button>
      <button class="icon-btn" id="like-btn" type="button" aria-label="Like song" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path transform="translate(0 -0.6)" d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 3.8C19 15.6 12 20 12 20Z" />
        </svg>
      </button>
      <button class="icon-btn" id="full-btn" type="button" aria-label="Open full now playing" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 4H5.5A1.5 1.5 0 0 0 4 5.5V9" /><path d="M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9" />
          <path d="M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15" /><path d="M4 15v3.5A1.5 1.5 0 0 0 5.5 20H9" />
        </svg>
      </button>
    </div>

    <div class="player-center">
      <div class="controls">
        <button class="icon-btn" id="prev-btn" type="button" aria-label="Previous song">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6 5h2v14H6zM18 5.5v13L8.5 12z" />
          </svg>
        </button>
        <button class="play-btn" id="play-btn" type="button" aria-label="Play"></button>
        <button class="icon-btn" id="next-btn" type="button" aria-label="Next song">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16 5h2v14h-2zM6 5.5v13L15.5 12z" />
          </svg>
        </button>
      </div>
      <div class="progress-row">
        <span id="cur">0:00</span>
        <input id="seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Seek" />
        <span id="dur">0:00</span>
      </div>
    </div>

    <div class="player-right">
      <button class="icon-btn" id="player-share" type="button" aria-label="Share song" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="18" cy="5.5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="18.5" r="2.5" />
          <path d="M8.2 10.9 15.8 6.6M8.2 13.1l7.6 4.3" />
        </svg>
      </button>
      <button class="icon-btn" id="mute-btn" type="button" aria-label="Mute">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <g transform="translate(1.3)">
            <path d="M4 9.5h3L12 5v14L7 14.5H4z" /><path d="M16 9a4 4 0 0 1 0 6" />
          </g>
        </svg>
      </button>
      <input id="volume" type="range" min="0" max="1" step="0.01" value="0.8" aria-label="Volume" />
    </div>
  </div>

  <dialog class="share playlist-sheet" id="playlist-sheet" aria-labelledby="playlist-sheet-title">
    <form method="dialog" class="share-head">
      <h2 id="playlist-sheet-title">Add to playlist</h2>
      <button class="share-x" type="submit" aria-label="Close playlists">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6 18 18M18 6 6 18" />
        </svg>
      </button>
    </form>
    <p class="playlist-sheet-track" id="playlist-sheet-track">—</p>
    <div class="playlist-pick" id="playlist-pick"></div>
    <p class="playlist-sheet-empty" id="playlist-sheet-empty" hidden>No playlists yet. Create one below.</p>
    <form class="playlist-create" id="playlist-create">
      <input
        id="playlist-create-name"
        type="text"
        maxlength="60"
        placeholder="New playlist name"
        autocomplete="off"
        aria-label="New playlist name"
      />
      <button type="submit">Create</button>
    </form>
  </dialog>

  <dialog class="share" id="share-dialog" aria-labelledby="share-title">
    <form method="dialog" class="share-head">
      <h2 id="share-title">Share</h2>
      <button class="share-x" type="submit" aria-label="Close share">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6 18 18M18 6 6 18" />
        </svg>
      </button>
    </form>

    <div class="share-track">
      <div class="share-art" id="share-art"><span aria-hidden="true">♪</span></div>
      <div class="share-copy">
        <p class="share-name" id="share-name">—</p>
        <p class="share-by" id="share-by">—</p>
      </div>
    </div>

    <div class="share-preview">
      <span>Playable preview</span>
      <iframe
        id="share-preview"
        title="Wavetify embed player preview"
        src="about:blank"
        height="152"
        loading="lazy"
        allow="autoplay; encrypted-media"
      ></iframe>
      <p class="share-note">Wavetify — free music, radio and podcasts. Stream full tracks, episodes and live stations.</p>
    </div>

    <div class="share-field">
      <span>Link</span>
      <div class="share-input">
        <input id="share-link" readonly />
        <button id="share-copy-link" type="button">Copy</button>
      </div>
    </div>

    <div class="share-field">
      <span>Embed player</span>
      <div class="share-input">
        <input id="share-embed" readonly />
        <button id="share-copy-embed" type="button">Copy</button>
      </div>
    </div>

    <button class="share-native" id="share-native" type="button" hidden>Share…</button>
  </dialog>

  <dialog class="share confirm" id="confirm-dialog" aria-labelledby="confirm-title">
    <form method="dialog" class="share-head">
      <h2 id="confirm-title">Clear history?</h2>
      <button class="share-x" type="submit" aria-label="Cancel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6 18 18M18 6 6 18" />
        </svg>
      </button>
    </form>
    <p class="confirm-text" id="confirm-text">
      This removes your play history and play counts from this device. Liked songs are kept.
    </p>
    <div class="confirm-actions">
      <button class="confirm-cancel" id="confirm-cancel" type="button">Cancel</button>
      <button class="confirm-ok" id="confirm-ok" type="button">Clear history</button>
    </div>
  </dialog>

  <div class="np" id="np" hidden role="dialog" aria-modal="true" aria-labelledby="np-title">
    <div class="np-ambient" id="np-ambient" aria-hidden="true"></div>
    <div class="np-sheet">
      <header class="np-top">
        <button class="np-close" id="np-close" type="button" aria-label="Close now playing">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 8.5 12 15.5 19 8.5" />
          </svg>
        </button>
        <p class="np-eyebrow"><span class="np-dot" id="np-dot" aria-hidden="true"></span><span id="np-source">Now playing</span></p>
        <button class="icon-btn" id="np-like" type="button" aria-label="Like song" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path transform="translate(0 -0.6)" d="M12 20s-7-4.4-7-9.2A4 4 0 0 1 12 7a4 4 0 0 1 7 3.8C19 15.6 12 20 12 20Z" />
          </svg>
        </button>
        <button class="icon-btn" id="np-add" type="button" aria-label="Add to playlist" title="Add to playlist" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 7h9" /><path d="M4 12h9" /><path d="M4 17h5" /><path d="M17 10v7" /><path d="M13.5 13.5h7" />
          </svg>
        </button>
        <button class="icon-btn" id="np-share" type="button" aria-label="Share song" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="18" cy="5.5" r="2.5" /><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="18.5" r="2.5" />
            <path d="M8.2 10.9 15.8 6.6M8.2 13.1l7.6 4.3" />
          </svg>
        </button>
        <div class="np-video-tools" id="np-video-tools">
          <button class="icon-btn" id="np-video-expand" type="button" aria-label="Enlarge video" title="Enlarge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 4h6v6" /><path d="m20 4-6 6" /><path d="M10 20H4v-6" /><path d="m4 20 6-6" />
            </svg>
          </button>
          <button class="icon-btn" id="np-video-fs" type="button" aria-label="Fullscreen video" title="Fullscreen">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 9V4h5" /><path d="M20 9V4h-5" /><path d="M4 15v5h5" /><path d="M20 15v5h-5" />
            </svg>
          </button>
          <button class="icon-btn" id="np-video-pip" type="button" aria-label="Picture in picture" title="Picture in picture">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="3" />
              <rect x="12" y="11" width="7" height="6" rx="1.5" fill="currentColor" stroke="none" />
            </svg>
          </button>
        </div>
      </header>

      <div class="np-scroll">
        <div class="np-body">
          <div class="np-video" id="np-video" hidden>
            <div class="np-video-frame" id="np-video-frame"></div>
          </div>

          <div class="np-art" id="np-art"><span aria-hidden="true">♪</span></div>

          <div class="np-copy">
            <h2 id="np-title">—</h2>
            <p class="np-artist" id="np-artist">—</p>
            <p class="np-desc" id="np-desc" hidden></p>
          </div>

          <div class="np-progress" id="np-progress">
            <input id="np-seek" type="range" min="0" max="1000" step="1" value="0" aria-label="Seek" />
            <div class="np-times"><span id="np-cur">0:00</span><span id="np-dur">0:00</span></div>
          </div>

          <div class="np-controls">
            <button class="icon-btn np-skip" id="np-prev" type="button" aria-label="Previous song">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h2v14H6zM18 5.5v13L8.5 12z" /></svg>
            </button>
            <button class="np-play" id="np-play" type="button" aria-label="Play"></button>
            <button class="icon-btn np-skip" id="np-next" type="button" aria-label="Next song">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 5h2v14h-2zM6 5.5v13L15.5 12z" /></svg>
            </button>
          </div>

          <div class="np-actions">
            <button class="np-detail" id="np-detail" type="button">More from this artist</button>
            <a class="np-link" id="np-link" target="_blank" rel="noreferrer noopener" hidden>Open source</a>
          </div>

          <section class="np-list" id="np-list" hidden>
            <h3 id="np-list-title">In this playlist</h3>
            <div class="tracklist" id="np-tracks"></div>
          </section>

          <section class="np-facts" id="np-facts" hidden>
            <h3 id="np-facts-title">Track details</h3>
            <dl class="np-info" id="np-info"></dl>
          </section>
        </div>
      </div>
    </div>
  </div>

  <audio id="audio" preload="metadata"></audio>
</Layout>

<script>
  import { init } from '../scripts/app';
  init();
</script>
