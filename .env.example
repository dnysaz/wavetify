# Copy this file to .env and fill in what you need. Every value is optional:
# the player works without them, only the matching rows/features stay hidden.

# Jamendo full-length tracks. Public client id from https://devportal.jamendo.com
# It ships in the client bundle as part of the request URL, so use the Client ID,
# never the Client Secret.
PUBLIC_JAMENDO_CLIENT_ID=

# YouTube music videos. Public API key with YouTube Data API v3 enabled, from
# https://console.cloud.google.com/apis/credentials
# Also ships in the client bundle — restrict it by HTTP referrer to your domain.
PUBLIC_YOUTUBE_API_KEY=

# Absolute site URL used for canonical links, og:url and og:image at build time.
# Set it in the build environment (SITE_URL=https://example.com npm run build);
# it is read by astro.config.mjs, not by the browser, so it has no PUBLIC_ prefix.
SITE_URL=https://wavetify.example
